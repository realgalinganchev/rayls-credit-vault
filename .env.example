# =============================================================================
# Rayls Credit Vault — Environment Configuration
# =============================================================================
# Copy to .env and fill in. Run `source .env` after every change.

# -- Credit vault deployment (the only variable OUR scripts need) -------------
# Deployer wallet private key. Generate with: cast wallet new
# For the local demo, script/Demo.s.sol uses Anvil's public default keys
# instead and needs NO env at all.
DEPLOYER_PRIVATE_KEY=0x

# -- Rayls networks (fill in once credentials arrive via the partnership) -----
# Public Chain RPC + chain ID (gated: operator approval required — see README)
PUBLIC_CHAIN_RPC_URL=
PUBLIC_CHAIN_ID=

# =============================================================================
# Rayls bridge reference (for the kept starter scripts: Deploy/Mint/Transfer/
# CheckBalance + HackathonToken). Not needed for the credit-vault PoC.
# =============================================================================
PRIVACY_NODE_RPC_URL=
DEPLOYMENT_PROXY_REGISTRY=0x
REGISTERED_PRIVATE_KEY=0x
TOKEN_NAME="My Token"
TOKEN_SYMBOL="MTK"
TOKEN_ADDRESS=0x
MINT_RECIPIENT=0x
MINT_AMOUNT=1000
TRANSFER_TO=0x
TRANSFER_AMOUNT=100
BACKEND_URL=
USER_AUTH_KEY=
OPERATOR_AUTH_KEY=
